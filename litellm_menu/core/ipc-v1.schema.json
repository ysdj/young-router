    "import": {"params": {"$ref": "#/$defs/importParams"}, "result": {"$ref": "#/$defs/importResult"}}
  },
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["protocol_version", "request_id", "method", "params"],
    "properties": {
      "protocol_version": {"const": 1},
      "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
      "method": {"enum": ["snapshot", "disk_state", "logs", "editor", "dispatch", "subscribe", "validate", "apply", "reload", "probe", "export", "import_preview", "import"]},
      "params": {"type": "object"}
    },
    "allOf": [
      {"if": {"properties": {"method": {"const": "snapshot"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/emptyParams"}}}},
      {"if": {"properties": {"method": {"const": "disk_state"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/diskStateParams"}}}},
      {"if": {"properties": {"method": {"const": "logs"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/logsParams"}}}},
      {"if": {"properties": {"method": {"const": "editor"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/editorParams"}}}},
      {"if": {"properties": {"method": {"const": "dispatch"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/dispatchParams"}}}},
      {"if": {"properties": {"method": {"const": "subscribe"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/subscribeParams"}}}},
      {"if": {"properties": {"method": {"const": "validate"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/domainRevisionParams"}}}},
      {"if": {"properties": {"method": {"const": "apply"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/applyParams"}}}},
      {"if": {"properties": {"method": {"const": "reload"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/reloadParams"}}}},
      {"if": {"properties": {"method": {"const": "probe"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/probeParams"}}}},
      {"if": {"properties": {"method": {"const": "export"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/exportParams"}}}},
      {"if": {"properties": {"method": {"const": "import_preview"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/importPreviewParams"}}}},
      {"if": {"properties": {"method": {"const": "import"}}}, "then": {"properties": {"params": {"$ref": "#/$defs/importParams"}}}}
    ]
