    "editorParams": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["domain", "document"], "properties": {"domain": {"enum": ["codex", "claude"]}, "document": {"enum": ["config", "auth", "settings", "desktop", "developer"]}}}, {"type": "object", "additionalProperties": false, "required": ["editor_token", "text"], "properties": {"editor_token": {"type": "string", "minLength": 1, "maxLength": 256}, "text": {"type": "string", "maxLength": 2097152}}}]},
    "dispatchAction": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1}, "domain": {"$ref": "#/$defs/domain"}, "payload": {"type": "object", "x-typescript-type": "Record<string, unknown>"}}, "additionalProperties": false, "x-typescript-type": "DispatchAction"},
    "dispatchParams": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"$ref": "#/$defs/dispatchAction"}, "revision": {"$ref": "#/$defs/revision"}}},
    "subscribeParams": {"type": "object", "additionalProperties": false, "properties": {"topics": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 64}}}},
    "domainRevisionParams": {"type": "object", "additionalProperties": false, "required": ["domain"], "properties": {"domain": {"$ref": "#/$defs/domain"}, "revision": {"$ref": "#/$defs/revision"}}},
    "applyParams": {"type": "object", "additionalProperties": false, "required": ["revision"], "oneOf": [{"required": ["domain"]}, {"required": ["domains"]}], "properties": {"domain": {"$ref": "#/$defs/domain"}, "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/domain"}}, "revision": {"$ref": "#/$defs/revision"}, "confirmation": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}}},
    "reloadParams": {"type": "object", "additionalProperties": false, "properties": {"domain": {"$ref": "#/$defs/domain"}, "revision": {"$ref": "#/$defs/revision"}}},
    "probeParams": {"type": "object", "additionalProperties": false, "properties": {"domain": {"enum": ["providers_models", "webdav"]}, "provider_id": {"type": "string", "minLength": 1}, "model_id": {"type": "string", "minLength": 1}}},
    "exportParams": {"type": "object", "additionalProperties": false, "required": ["sections", "destination_token"], "properties": {"sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/domain"}}, "destination_token": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "importPreviewParams": {"type": "object", "additionalProperties": false, "required": ["source_token", "revision"], "properties": {"source_token": {"type": "string", "minLength": 1, "maxLength": 256}, "revision": {"$ref": "#/$defs/revision"}}},
    "importParams": {"type": "object", "additionalProperties": false, "required": ["import_plan_token", "sections", "revision"], "properties": {"import_plan_token": {"type": "string", "minLength": 1, "maxLength": 256}, "sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/domain"}}, "revision": {"$ref": "#/$defs/revision"}}},
    "coreSnapshot": {"type": "object", "x-typescript-type": "CoreSnapshot"},
    "diskState": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["changed", "generation"], "properties": {"changed": {"type": "boolean"}, "generation": {"$ref": "#/$defs/revision"}, "keep_draft": {"type": "boolean"}}}, "x-typescript-type": "Partial<Record<ConfigDomain, DiskState>>"},
    "validationSummary": {"type": "object", "x-typescript-type": "ValidationSummary"},
    "importPreview": {"type": "object", "x-typescript-type": "Partial<Record<ConfigDomain, { available: boolean; will_replace_draft: boolean }>>"},
    "snapshotResult": {"type": "object", "additionalProperties": false, "required": ["snapshot"], "properties": {"snapshot": {"$ref": "#/$defs/coreSnapshot"}}},
    "diskStateResult": {"type": "object", "additionalProperties": false, "required": ["revision", "disk"], "properties": {"revision": {"$ref": "#/$defs/revision"}, "disk": {"$ref": "#/$defs/diskState"}}},
    "logView": {"type": "object", "additionalProperties": false, "required": ["tab", "available", "paused", "line_count", "records", "filter", "limit"], "properties": {"tab": {"$ref": "#/$defs/logTab"}, "available": {"type": "boolean"}, "paused": {"type": "boolean"}, "line_count": {"type": "integer", "minimum": 0}, "records": {"type": "array", "maxItems": 100000, "items": {"type": ["object", "string"]}}, "filter": {"type": "string", "maxLength": 256}, "limit": {"type": "integer", "minimum": 1}}, "x-typescript-type": "LogView"},
    "logsResult": {"type": "object", "additionalProperties": false, "required": ["changed", "revision", "log"], "properties": {"changed": {"type": "boolean"}, "revision": {"$ref": "#/$defs/revision"}, "log": {"oneOf": [{"$ref": "#/$defs/logView"}, {"type": "null"}]}}},
    "editorResult": {"type": "object", "additionalProperties": false, "required": ["domain", "document", "editor_token", "revision", "text", "baseline"], "properties": {"domain": {"enum": ["codex", "claude"]}, "document": {"enum": ["config", "auth", "settings", "desktop", "developer"]}, "editor_token": {"type": "string", "minLength": 1, "maxLength": 256}, "revision": {"$ref": "#/$defs/revision"}, "text": {"type": "string", "maxLength": 2097152}, "baseline": {"type": "string", "maxLength": 2097152}}},
    "revisionResult": {"type": "object", "additionalProperties": false, "required": ["revision"], "properties": {"revision": {"$ref": "#/$defs/revision"}}},
    "subscribeResult": {"type": "object", "additionalProperties": false, "required": ["subscription_id"], "properties": {"subscription_id": {"type": "string"}}},
    "validateResult": {"type": "object", "additionalProperties": false, "required": ["validate"], "properties": {"validate": {"$ref": "#/$defs/validationSummary"}}},
    "applyIssue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "operation_id": {"type": "string"},
        "domain": {"$ref": "#/$defs/domain"},
        "station_id": {"type": "string"},
        "account_id": {"type": "string"},
        "resource_id": {"type": "string"},
        "provider_id": {"type": "string"},
        "model_id": {"type": "string"},
        "retryable": {"type": "boolean"}
      }
    },
    "applyIssues": {"type": "array", "items": {"$ref": "#/$defs/applyIssue"}, "x-typescript-type": "ApplyIssue[]"},
    "applyResult": {"type": "object", "additionalProperties": false, "required": ["revision", "applied", "status", "completed_operations", "pending_operations", "issues"], "properties": {"revision": {"$ref": "#/$defs/revision"}, "applied": {"type": "boolean"}, "domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}}, "status": {"enum": ["applied", "partial", "failed"]}, "completed_operations": {"type": "integer", "minimum": 0}, "pending_operations": {"type": "integer", "minimum": 0}, "issues": {"$ref": "#/$defs/applyIssues"}}},
    "probeResult": {"type": "object", "required": ["ok", "protocols"], "properties": {"ok": {"type": "boolean"}, "protocols": {"type": "array", "items": {"type": "string"}}, "detail": {"type": "string"}, "available": {"type": "boolean"}, "provider_id": {"type": "string"}, "model_id": {"type": "string"}, "recommended_surface": {"enum": ["openai/responses", "openai/chat", "anthropic", null]}, "summary": {"type": "object", "required": ["available_surfaces", "unavailable_surfaces", "statuses"], "properties": {"available_surfaces": {"type": "array", "items": {"type": "string"}}, "unavailable_surfaces": {"type": "array", "items": {"type": "string"}}, "statuses": {"type": "object", "x-typescript-type": "Record<string, string>"}}}, "surfaces": {"type": "array", "items": {"type": "object", "required": ["surface", "available"], "properties": {"surface": {"type": "string"}, "available": {"type": "boolean"}, "status": {"type": "string"}, "original_request": {"type": "object", "required": ["method", "url", "headers", "body"], "properties": {"method": {"type": "string"}, "url": {"type": "string"}, "headers": {"type": "object", "x-typescript-type": "Record<string, string>"}, "body": {"type": "object", "x-typescript-type": "Record<string, unknown>"}}}}}}}},
    "exportResult": {"type": "object", "additionalProperties": false, "required": ["revision", "section_count"], "properties": {"revision": {"$ref": "#/$defs/revision"}, "section_count": {"type": "integer", "minimum": 0}, "sections": {"type": "array", "items": {"$ref": "#/$defs/domain"}}}},
    "importPreviewResult": {"type": "object", "additionalProperties": false, "required": ["revision", "import_plan_token", "detected_sections", "preview"], "properties": {"revision": {"$ref": "#/$defs/revision"}, "import_plan_token": {"type": "string", "minLength": 1, "maxLength": 256}, "detected_sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/domain"}}, "preview": {"$ref": "#/$defs/importPreview"}}},
    "importResult": {"type": "object", "additionalProperties": false, "required": ["revision", "draft_domains", "preview"], "properties": {"revision": {"$ref": "#/$defs/revision"}, "draft_domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}}, "preview": {"$ref": "#/$defs/importPreview"}}}
  }
}
