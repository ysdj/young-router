#!/usr/bin/env bash
# Refuse a commit whose *message* would record a private value.
#
# This is a hook of its own because ``pre-commit`` runs before git writes the
# message file: with ``git commit -m`` there is nothing for pre-commit to read
# yet, and the message is exactly where a pasted transcript carries a home path
# or an internal hostname.  The hook edits the file in place, so it also blocks
# the ``--amend`` and editor paths.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

MESSAGE_FILE="${1:-}"
if [[ -z "$MESSAGE_FILE" ]]; then
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "repo hygiene: python3 is not installed; skipped (CI still enforces this)" >&2
  exit 0
fi

exec python3 scripts/check-repo-hygiene.py --message "$MESSAGE_FILE"
