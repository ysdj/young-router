{
  "name": "@litellm-menu/rn-app",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React Native UI and native shells for LiteLLM Menu.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap:rnmacos": "node scripts/bootstrap-rnmacos-085.mjs",
    "code-editor:build": "node scripts/build-code-editor.mjs",
    "verify:rnmacos": "node scripts/verify-rnmacos-085.mjs",
    "codegen:windows": "react-native-windows-codegen --files packages/shared/src/ui/windows/*NativeComponent.ts --componentsWindows --libraryName LiteLLMMenu --namespace winrt::LiteLLMMenu::Codegen --outputDirectory apps/windows/windows/LiteLLMMenu/codegen",
    "codegen:windows:check": "pnpm run codegen:windows --test",
    "typecheck": "pnpm run code-editor:build && tsc --noEmit",
    "contract-check": "node scripts/check-contract.mjs",
    "test": "node ../tests/test_rn_contract.mjs && node --no-warnings --experimental-strip-types ../tests/test_rn_tooltip.mjs && node --no-warnings --experimental-strip-types ../tests/test_rn_relay_origin.mjs",
    "check:macos": "pnpm run test && pnpm run contract-check && pnpm run typecheck",
    "build": "pnpm run test && pnpm run contract-check && pnpm run typecheck && pnpm run codegen:windows:check",
    "build:macos": "./scripts/build-macos.sh",
    "build:windows": "pwsh ./scripts/build-windows.ps1"
  },
  "dependencies": {
    "ace-builds": "1.44.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-windows": "0.85.0-preview.1"
  },
  "devDependencies": {
    "@react-native-windows/codegen": "0.85.0-preview.1",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@types/react": "19.2.3",
    "esbuild": "0.25.8",
    "typescript": "5.7.2"
  }
}
