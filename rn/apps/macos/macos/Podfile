ENV['RCT_USE_RN_DEP'] = '0'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_BUILD_HERMES_FROM_SOURCE'] = 'true'
ENV['RCT_HERMES_V1_ENABLED'] = '1'
ENV['RCT_NEW_ARCH_ENABLED'] = '1'
require 'json'

# The 0.85 merge branch has the newer JSI Hermes interface, while its source
# tag still points at .0.2. Use the matching official .0.6 source revision.
react_native_macos_lock = JSON.parse(File.read(File.expand_path("../../../vendor/react-native-macos-0.85.json", __dir__)))
ENV['HERMES_COMMIT'] = react_native_macos_lock.fetch('hermes').fetch('sourceCommit')

react_native_macos_path = File.expand_path("../../../vendor/react-native-macos-0.85/packages/react-native", __dir__)
react_native_macos_relative_path = "../../../vendor/react-native-macos-0.85/packages/react-native"
app_path = File.expand_path("..", __dir__)

require File.join(react_native_macos_path, "scripts/react_native_pods")

prepare_react_native_project!

target 'YoungRouter-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  use_react_native!(
    :path => react_native_macos_path,
    :hermes_enabled => true,
    :fabric_enabled => true,
    :app_path => app_path,
    :config_file_dir => app_path
  )

  post_install do |installer|
    react_native_post_install(installer, react_native_macos_relative_path)

    # Fourteen pods in this tree include
    # ``FBReactNativeSpec/FBReactNativeSpecJSI.h`` — among them
    # ``React-Fabric``'s ``NativeAnimatedNodesManager.h`` and ``AnimatedModule.h``,
    # plus ``React-FabricImage``, ``ReactCommon``, and the
    # ``react/nativemodule/*`` pods.
    #
    # The header is published by the ``React-RCTFBReactNativeSpec`` pod, which
    # declares ``header_dir = 'FBReactNativeSpec'``, so CocoaPods installs it one
    # directory deeper than the search path every pod already carries:
    #
    #   Pods/Headers/Public/FBReactNativeSpec/...                      (searched)
    #   Pods/Headers/Public/React-RCTFBReactNativeSpec/FBReactNativeSpec/...  (actual)
    #
    # ``React-Fabric`` does not depend on ``React-RCTFBReactNativeSpec``, so
    # nothing adds the pod's own header root to its build, and the compile ends:
    #
    #   fatal error: 'FBReactNativeSpec/FBReactNativeSpecJSI.h' file not found
    #
    # The pod's own header root is added below to the targets that lack it, and
    # it is the entry CocoaPods itself generates: ``React-FabricComponents``
    # declares this dependency and carries the same path verbatim, so a target
    # that already resolves the header is left alone. The addition is written
    # into the xcconfig CocoaPods generated, which is where every target in this
    # build keeps its search paths — neither the Pods project nor this app's
    # project sets ``HEADER_SEARCH_PATHS`` itself.
    #
    # The directory publishes only ``FBReactNativeSpec`` and
    # ``react/renderer/components/FBReactNativeSpec``, so it cannot shadow a
    # header another target meant to find first. Upstream 0.86 carries the same
    # class of fix for a different header in this subspec (facebook/react-native
    # #56151, ``header_mappings_dir`` on ``React-Fabric/animated``), but it does
    # not cover this include and it is not on the pinned 0.85 branch, so the
    # search path is added here rather than by moving the vendor pin.
    fbreactnativespec_header_root = 'Headers/Public/React-RCTFBReactNativeSpec'
    search_path_entry = "\"$(PODS_ROOT)/#{fbreactnativespec_header_root}\""

    add_fbreactnativespec_search_path = lambda do |attributes|
      existing = attributes['HEADER_SEARCH_PATHS'] || '$(inherited)'
      next if existing.include?(search_path_entry)

      attributes['HEADER_SEARCH_PATHS'] = "#{existing} #{search_path_entry}"
    end

    # Every pod, not a hand-kept list: the sources that include the header
    # live in pods React Native reorganizes between releases, and a stale list
    # would fail the build only on the release that moved one.
    #
    # The path goes into the Pods project's own build settings, not only into the
    # xcconfig CocoaPods wrote. A build setting set on the target takes
    # precedence over the xcconfig, so this survives a later `update_changed_file`
    # rewriting that file from the target's settings — which is exactly the
    # state a second `pod install` recomputes. `$(inherited)` keeps every path
    # CocoaPods already generated for the target, so this adds rather than
    # replaces.
    #
    # It is added unconditionally rather than guarded on the header directory
    # existing here. CocoaPods removes and re-creates that store while it
    # installs, so whether it is present at this point in the run is an ordering
    # detail, and a search path naming a directory this build never creates is
    # inert.
    installer.pods_project.targets.each do |pods_target|
      pods_target.build_configurations.each do |config|
        existing = config.build_settings['HEADER_SEARCH_PATHS']
        existing = '$(inherited)' if existing.nil? || existing.empty?
        next if existing.include?(search_path_entry)

        config.build_settings['HEADER_SEARCH_PATHS'] =
          existing.is_a?(Array) ? existing + [search_path_entry] : "#{existing} #{search_path_entry}"
      end
    end

    # The same path in the xcconfig each pod target owns preserves the behaviour
    # of a build that reads only that file, and keeps the aggregate target below
    # from being the only one that carries it.
    installer.pod_targets.each do |pod_target|
      pod_target.build_settings.each_key do |config_name|
        xcconfig_path = pod_target.xcconfig_path(config_name)
        next unless File.exist?(xcconfig_path)

        xcconfig = Xcodeproj::Config.new(xcconfig_path)
        before = xcconfig.attributes['HEADER_SEARCH_PATHS']
        add_fbreactnativespec_search_path.call(xcconfig.attributes)
        xcconfig.save_as(xcconfig_path) if xcconfig.attributes['HEADER_SEARCH_PATHS'] != before
      end
    end

    # The app target is an aggregate, and it compiles the host's own sources
    # against the same headers, so it needs the path for the same reason.
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        before = config_file.attributes['HEADER_SEARCH_PATHS']
        add_fbreactnativespec_search_path.call(config_file.attributes)
        next if config_file.attributes['HEADER_SEARCH_PATHS'] == before

        config_file.save_as(aggregate_target.xcconfig_path(config_name))
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.0'
      end
    end
  end
end
